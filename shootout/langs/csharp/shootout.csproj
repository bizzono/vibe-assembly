<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built by shootout.py with: dotnet build -c Release -o out
       Tiered compilation, on-stack replacement and dynamic PGO are left at the runtime's defaults. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>shootout</AssemblyName>
    <RootNamespace>Shootout</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The runner starts the program as `dotnet out/shootout.dll`, so no native launcher is needed. -->
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
